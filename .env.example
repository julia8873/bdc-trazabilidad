# ==========================================
# GitHub Tokens (Acceso a repositorios)
# ==========================================
GITHUB_TOKEN=tu_github_token_aqui
GITHUB_PAT=tu_github_pat_aqui

# ==========================================
# FASE 10: Agente Evaluador (LLM-as-Judge)
# ==========================================

# 1. Habilitar el endpoint del agente (si es false devuelve 503)
ENABLE_EVALUATION_AGENT=true

# 2. Clave del modelo LLM (puedes usar la de Gemini o la de OpenAI)
GEMINI_API_KEY=tu_api_key_gemini_aqui
# OPENAI_API_KEY=tu_api_key_openai_aqui

# 3. Token de GitHub dedicado para que el agente lea commits y diffs de los alumnos
# se puede obtener con: openssl rand -hex 32
GITHUB_TOKEN_AGENT=tu_github_token_para_agente_aqui

# 4. Secreto HMAC para firmar el historial y evitar manipulaciones en el seguimiento
AGENT_HMAC_SECRET=tu_clave_hmac_secreta_aqui

# 5. Conexión con el servicio mapeo-api
MAPEO_API_URL=http://localhost:8001
MAPEO_API_TOKEN=tu_mapeo_api_token_aqui
